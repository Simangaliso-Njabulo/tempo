{
  "name": "tempo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:domain": "vitest run --config vitest.domain.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --grep-invert \"@visual|@performance\"",
    "test:e2e:webkit": "playwright test --project=webkit-iphone --grep-invert \"@visual|@performance\"",
    "test:a11y": "playwright test --grep @a11y",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "check:pwa": "node scripts/check-pwa.mjs",
    "verify:pwa": "npm run build && npm run check:pwa",
    "size": "node scripts/check-size.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "security:sbom": "cyclonedx-npm --output-file sbom.cdx.json",
    "security:policy": "node scripts/security/check-policy.mjs",
    "security:deps": "npm audit --audit-level=high",
    "security:workflows": "actionlint",
    "security:secrets": "gitleaks detect --source . --redact --no-banner",
    "verify:security": "npm run security:policy && npm run security:deps && npm run security:workflows && npm run security:secrets",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run size && npm run check:pwa",
    "verify:full": "npm run verify && npm run test:coverage && npm run test:e2e && npm run test:perf && npm run lighthouse",
    "format": "prettier --write .",
    "test:perf": "playwright test --grep @performance --workers=1"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-boundaries": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  }
}
